# Environment files — real secrets never enter the repo.
# Only the *.example templates are committed.
.env
.env.*
!.env.*.example
!.env.example

.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Test coverage (pytest-cov)
.coverage
htmlcov/

# Logs
*.log
# ...except the soak-report fixtures, which are trimmed, hand-written captures
# the tests assert against. Without this the suite passes locally (the files
# exist on disk) and fails in CI (they were never committed).
!backend/tests/fixtures/soak/*.log

# Local conversation checkpoint database (M11)
checkpoints.db*
