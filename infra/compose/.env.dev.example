# Template for the Langfuse DEV-stack secrets (M08; M28 splits dev/prod).
# Copy to `infra/compose/.env.dev` and fill in real values. NEVER commit
# `.env.dev` — it holds credentials and is git-ignored (.gitignore: `.env.*`);
# only this `.example` template is tracked.
#
# PROD uses a SEPARATE file, `infra/compose/.env.prod` (from
# `.env.prod.example`) — dev and prod secrets never share a file.
#
# Generate the random secrets with:
#   openssl rand -hex 32      # SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET
#
# TIP: keep comments on their OWN lines. Compose's .env parser treats `#` only
# at the start of a line as a comment — an inline `# ...` after a value is kept
# as part of the value (and ENCRYPTION_KEY must stay exactly 64 hex chars).

# --- Postgres ---
POSTGRES_PASSWORD=postgres

# --- Langfuse app secrets (64 hex chars each) ---
SALT=REPLACE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_hex_32

# --- Redis ---
REDIS_AUTH=myredissecret

# --- ClickHouse ---
CLICKHOUSE_PASSWORD=clickhouse

# --- MinIO (also feeds the Langfuse S3 upload keys) ---
MINIO_ROOT_PASSWORD=miniosecret

# --- Headless init: default admin user + project API keys ---
LANGFUSE_INIT_USER_PASSWORD=dev-password-123
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_dev0000000000000001
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_dev0000000000000001
