# Template for the PROD stack secrets on the DeskMini (M28).
# Copy to `infra/compose/.env.prod` and fill in real values. NEVER commit
# `.env.prod` — it holds credentials and is git-ignored (.gitignore: `.env.*`);
# only this `.example` template is tracked. The dev machine uses a SEPARATE
# file, `infra/compose/.env.dev` (from `.env.dev.example`).
#
# Generate the random secrets with:
#   openssl rand -hex 32      # SALT, ENCRYPTION_KEY, NEXTAUTH_SECRET
#   openssl rand -base64 32   # APP_DB_PASSWORD alternative (see note below)
#
# TIP: keep comments on their OWN lines (compose .env parser keeps inline
# `#` as part of the value — and ENCRYPTION_KEY must stay exactly 64 hex).

# --- Postgres (Langfuse's own DB, from M08) ---
POSTGRES_PASSWORD=REPLACE_ME_STRONG

# --- Langfuse app secrets (64 hex chars each) ---
SALT=REPLACE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_ME_openssl_rand_hex_32
NEXTAUTH_SECRET=REPLACE_ME_openssl_rand_hex_32

# --- Redis ---
REDIS_AUTH=REPLACE_ME_STRONG

# --- ClickHouse ---
CLICKHOUSE_PASSWORD=REPLACE_ME_STRONG

# --- MinIO (also feeds the Langfuse S3 upload keys) ---
MINIO_ROOT_PASSWORD=REPLACE_ME_STRONG

# --- M28: app checkpointer Postgres (app-db service) ---
# ALPHANUMERIC ONLY (no ':', '@', '/') — the value is inlined into the
# backend's CHECKPOINT_DB_URL connection string.
APP_DB_USER=assistant
APP_DB_PASSWORD=REPLACE_ME_ALPHANUMERIC
APP_DB_NAME=assistant

# --- M28: Langfuse browser URL (what YOU type to open the dashboards) ---
# Reachable from your laptop/phone on the LAN, e.g. http://192.168.1.50:3000
# or http://deskmini.local:3000 (mDNS). Must match the browser address bar.
NEXTAUTH_URL=http://deskmini.local:3000

# --- Headless init: prod admin + project API keys ---
LANGFUSE_INIT_USER_PASSWORD=REPLACE_ME_STRONG
# CRITICAL: these two MUST equal the LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY
# you put in backend/.env.prod — they are the credentials the backend SDK
# uses to talk to THIS project. Generate a fresh pair, not the dev ones.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-REPLACE_ME_PROD
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-REPLACE_ME_PROD

# --- M28 (optional overrides of the prod.yml defaults) ---
# Only needed if you don't like the defaults baked into docker-compose.prod.yml.
# LANGFUSE_INIT_ORG_ID=prod-org
# LANGFUSE_INIT_ORG_NAME=Prod Org
# LANGFUSE_INIT_PROJECT_ID=prod-project
# LANGFUSE_INIT_PROJECT_NAME=Prod Project
# LANGFUSE_INIT_USER_EMAIL=admin@home.local
# LANGFUSE_INIT_USER_NAME=Prod Admin
