{
  "configurations": [
    {
      // Any name; it is only the label shown in the C/C++ status UI.
      "name": "ESP-IDF",

      // The authoritative flag list, regenerated by every `idf.py build`.
      // cpptools reads one entry per .c file: the exact compiler, the
      // -D defines (including the CONFIG_* macros from sdkconfig) and all
      // 48 -I include directories. When this file is set, cpptools uses
      // it instead of compilerPath/includePath/defines below.
      //
      // ${workspaceFolder} keeps this portable across machines; the
      // database itself is machine-specific and gitignored, so a fresh
      // clone must run `idf.py build` once before the squiggles clear.
      "compileCommands": "${workspaceFolder}/firmware/satellite-xvf3800-xiao/build/compile_commands.json",

      // Fallback only: used for headers that appear in no database entry
      // (for example a .h opened before it is included anywhere).
      "includePath": [
        "${workspaceFolder}/firmware/satellite-xvf3800-xiao/main",
        "${workspaceFolder}/firmware/satellite-xvf3800-xiao/build/config"
      ],

      // ESP-IDF 5.4 compiles with -std=gnu17. Stated here so the fallback
      // path parses identically to the real build.
      "cStandard": "gnu17",
      "cppStandard": "c++20",

      // cpptools has no Xtensa mode. `gcc-x64` is the closest match: it
      // selects the GCC-compatible behaviour and the 64-bit predefined
      // macro set. It does not affect which files resolve, because
      // compileCommands supplies the real flags.
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
