# Template for local DEV environment. Copy to `.env.dev` and fill in real values.
# NEVER commit `.env.*` (only these `.env.*.example` templates are committed).
ENV=dev
DEEPSEEK_API_KEY=sk-REPLACE_ME
ASSISTANT_API_KEY=REPLACE_ME
DEFAULT_TIMEZONE=Europe/Berlin
SUPPORTED_LANGUAGES=["en","de","pt-BR"]

# --- Runtime knobs & LLM model tiers ---
# Defaults match app/core/config.py; uncomment + change only to override.
# CHECKPOINT_DB_PATH=checkpoints.db          # relocate the SQLite memory DB
# GRAPH_TIMEOUT_SECONDS=90                   # deadline for one graph run
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash     # tier used by router/specialist/responder
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro         # reserved for a future pro role

# --- Observability: Langfuse ---
# LANGFUSE_BASE_URL here is for the SDK (runs on the HOST -> published port).
# The compose file's LANGFUSE_HOST is for the langfuse CONTAINERS (service name).
# Two different things, deliberately different values.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_BASE_URL=http://localhost:3000
