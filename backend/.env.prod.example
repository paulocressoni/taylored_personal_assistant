# Template for local PROD environment. Copy to `.env.prod` and fill in real values.
# NEVER commit `.env.*` (only these `.env.*.example` templates are committed).
ENV=prod
DEEPSEEK_API_KEY=sk-REPLACE_ME
ASSISTANT_API_KEY=REPLACE_ME # same as frontend VITE_API_KEY
DEFAULT_TIMEZONE=Europe/Berlin
SUPPORTED_LANGUAGES=["en","de","pt-BR"]

# --- Runtime knobs & LLM model tiers ---
# Defaults match app/core/config.py; uncomment + change only to override.
# CHECKPOINT_DB_PATH is DEV-only (SQLite memory file). In PROD the graph uses
# Postgres: docker-compose.prod.yml injects CHECKPOINT_DB_URL automatically.
# Leave BOTH unset here so prod is unambiguous — the compose-injected DSN
# decides, and a stray CHECKPOINT_DB_PATH would be dead weight.
# CHECKPOINT_DB_PATH=checkpoints.db          # relocate the SQLite memory DB (dev only)
# GRAPH_TIMEOUT_SECONDS=90                   # deadline for one graph run
# DEEPSEEK_MODEL_FLASH=deepseek-v4-flash     # tier used by router/specialist/responder
# DEEPSEEK_MODEL_PRO=deepseek-v4-pro         # reserved for a future pro role
# MAX_HISTORY_MESSAGES=20            # model-facing history window
# RATE_LIMIT_REQUESTS=30             # per-key requests per window
# RATE_LIMIT_WINDOW_SECONDS=60       # sliding-window length for the above

# --- Voice (speech in/out) ---
# Only switch this on once BOTH keys below are set: startup fails fast otherwise.
VOICE_ENABLED=true
VOICE_STT_API_KEY=gsk_REPLACE_ME
VOICE_TTS_API_KEY=sk-REPLACE_ME

# --- Observability: Langfuse ---
# Only the KEYS are meaningful here: the SDK reads LANGFUSE_PUBLIC_KEY /
# LANGFUSE_SECRET_KEY. LANGFUSE_BASE_URL is overridden by the compose
# overlays to the langfuse-web SERVICE NAME inside the container network, so
# the localhost value below is just a harmless fallback for host-run uvicorn.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
LANGFUSE_BASE_URL=http://localhost:3000
