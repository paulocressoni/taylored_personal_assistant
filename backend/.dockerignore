# backend/.dockerignore — keep the build context tiny + secret-free
.venv
__pycache__
.git
node_modules

# Secrets must never enter a build context or image. The image is built
# from committed, secret-free source only — .env.dev / .env.prod are
# injected at runtime via compose env_file, never baked at build time.
.env*
.env

# safety extras (build artifacts, caches, editor junk)
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.idea
.vscode
backend.egg-info
dist
build
